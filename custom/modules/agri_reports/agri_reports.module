}

/**
 * Implements agri_reports_views_pre_view hook.
 */
function agri_reports_views_pre_view($view, $display_id, &$args) {
  if ($view->id() == 'publish_activity_for_meta_tags' || $view->id() == 'publish_activity_new_pages') {
    $values = $view->getExposedInput();
    if (!empty($values)) {
      if (empty(trim($values["field_issued_value"]['min'])) || empty(trim($values["field_issued_value"]['max']))) {
        $values["field_issued_value"]['min'] = ' ';
        $values["field_issued_value"]['max'] = ' ';
        $view->setExposedInput($values);
      }
    }
  }

  if ($view->id() == 'publish_activity_reporting') {
    $values = $view->getExposedInput();
    if (!empty($values)) {
      if (empty(trim($values["created"]['min'])) || empty(trim($values["created"]['max']))) {
        $values["created"]['min'] = ' ';
        $values["created"]['max'] = ' ';
        $view->setExposedInput($values);
      }
    }
  }
}

/**
 * Implements hook_reports_cron().
 */
function agri_reports_cron() {
  $filedirectory = 'public://cache_warming/';
  $database = \Drupal::database();
  AdminHelper::CreateWarmingCacheJsonfile($filedirectory, $database);
}
