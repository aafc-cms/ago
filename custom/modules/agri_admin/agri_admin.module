/**
 * Implements hook_preprocess_html().
 */
function agri_admin_preprocess_html(&$variables) {
  $current_path = \Drupal::service('path.current')->getPath();
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $current_path = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $variables['current_path'] = $current_path;
  $clean_path = preg_replace('/[\W]/', '', $variables['current_path']);
  if (strlen($clean_path) > 30) {
    $clean_path = substr($clean_path, 0, 29);
  }
  if (strpos($current_path, 'node') > 0) {
    if (substr_compare($current_path, 'edit', -strlen('edit')) === 0) {
      $clean_path = 'node-edit';
    }
  }
  $variables['attributes']['class'][] = $clean_path;
  $current_user = \Drupal::currentUser();
  $roles = $current_user->getRoles();
  foreach ($roles as $rolename) {
    $variables['attributes']['class'][] = 'role-is-' . $rolename;
  }
  $path = \Drupal::request()->getpathInfo();
  $arg  = explode('/', $path);
  if ($arg[0] == $langcode && isset($arg[2])) {
    $first_two_elements = $arg[1] . '-' . $arg[2];
  }
  if ($arg[1] == $langcode && isset($arg[3])) {
    $first_two_elements = $arg[2] . '-' . $arg[3];
  }
  if (isset($first_two_elements)) {
    $variables['attributes']['class'][] = $first_two_elements;
  }

}

/**
 * Implements hook_page_attachments().
 *
 * Adds the agri-admin libraries to each page.
 */
function agri_admin_page_attachments(array &$page) {
  $user = \Drupal::currentUser();
  if ($user->hasPermission('aafc admin styles')) {
    $page['#attached']['library'][] = 'agri_admin/agri-admin';
    $current_route = \Drupal::routeMatch()->getRouteName();
    if ($current_route == 'content_moderation.admin_moderated_content' || $current_route == 'system.admin_content') {
      global $base_url;
      $page['#attached']['drupalSettings']['aafc']['base_url'] = $base_url;
      $page['#attached']['library'][] = 'agri_admin/legacy-support';
      $page['#attached']['library'][] = 'agri_admin/content-plugins-changes';
      $page['#attached']['drupalSettings']['aafc']['show_restricted_plugins_permissions'] = $user->hasPermission('aafc show restricted plugins');
    }
    if ($current_route == 'content_moderation.admin_moderated_content') {
      $page['#attached']['library'][] = 'agri_admin/agri_moderated_content';
    }
    if ($current_route == 'entity.node.edit_form' || $current_route == 'node.add') {
      $entity_id = NULL;
      $uuid = NULL;
      if (AgriAdminHelper::getSampleTopicImageUuidAndEntityId($uuid, $entity_id)) {
        $page['#attached']['drupalSettings']['campaign']['found_demo_topic'] = TRUE;
        $page['#attached']['drupalSettings']['campaign']['media_uuid'] = $uuid;
        $page['#attached']['drupalSettings']['campaign']['media_entity_id'] = $entity_id;
        $page['#attached']['drupalSettings']['special']['found_demo_topic'] = TRUE;
        $page['#attached']['drupalSettings']['special']['media_uuid'] = $uuid;
        $page['#attached']['drupalSettings']['special']['media_entity_id'] = $entity_id;
      }
      else {
        $page['#attached']['drupalSettings']['campaign']['found_demo_topic'] = FALSE;
        $page['#attached']['drupalSettings']['special']['found_demo_topic'] = FALSE;
      }
    }
  }
}

