{#
/**
 * @file
 * Default theme implementation for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 *
 * @ingroup templates
 */
#}
{% set container = theme.settings.fluid_container ? 'container-fluid' : 'container' %}
{% if breadcrumb %}
  <nav id="wb-bc" property="breadcrumb" aria-labelledby="breadcrumbTitle">
    <h2{{ title_attributes.setAttribute('id', 'breadcrumbTitle') }}>{{ 'You are here'|t }}</h2>
    <div class="{{ container }}">
      <ol class="breadcrumb">
        {% for item in breadcrumb %}
        {% if ('Home' == item.text) %}
        {% set item=item|merge({'text':'Agriculture and Agri-Food Canada'}) %}
        <li {{ item.attributes }}><a href="https://canada.ca/en">Canada.ca</a></li>
        {% elseif ('Accueil' == item.text) %}
        {% set item=item|merge({'text':'Agriculture et Agroalimentaire Canada'}) %}
        <li {{ item.attributes }}><a href="https://canada.ca/fr">Canada.ca</a></li>
        {% else %}
        {% endif %}
          <li {{ item.attributes }}>
            {% if item.url %}
              <a href="{{ item.url }}">{{ item.text }}</a>
            {% else %}
              {{ item.text }}
            {% endif %}
          </li>
        {% endfor %}
      </ol>
  </div>
</nav>
{% endif %}
