{
    "name": "agrcmsx/internet",
    "description": "WxT based internet sub project",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_admin"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_reports"
        },
        {
            "type": "path",
            "url": "custom/modules/prefer_latest_content"
        },
        {
            "type": "path",
            "url": "custom/modules/wxt_overrides"
        },
        {
            "type": "path",
            "url": "custom/themes/aafctheme"
        },
        {
            "type": "path",
            "url": "custom/config"
        }
    ],
    "scripts": {
        "post-root-package-install": [
            "DrupalWxT\\WxT\\ScriptHandler::postCreateProject"
        ],
        "pre-install-cmd": [
            "if [ -d html/sites/default ]; then chmod 775 html/sites/default; fi"
        ],
        "post-install-cmd": [
            "bash post_install.sh"
        ],
        "post-update-cmd": [
            "bash post_install.sh"
        ],
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
          "bower-asset",
          "npm-asset",
          "custom-module",
          "custom-theme"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}" : [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/custom/{$name}": [
                "drupal/wxt_library",
                "type:drupal-custom-module"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/custom/{$name}": [
                "drupal/wxt_bootstrap",
                "type:drupal-custom-theme"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": false,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "1166282 - Titles truncated on parent menu":
                "https://www.drupal.org/files/issues/2021-04-12/1166282-29.patch",
                "Taxonomy term weight is not translatable, meaning you can't order term translations differently":
                "https://www.drupal.org/files/issues/2020-04-30/make-taxonomy-weight-translatable-2931680-8.patch"
            },
            "drupal/wxt": {
                "wcag - fix the report a problem webform markup":
                "https://www.drupal.org/files/issues/2021-01-22/wxt-ext-webform-config-change-3194287-3.patch"
            }
        },
        "patches-ignore": {
            "acquia/lightning": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                }
            },
            "drupal/lightning_core": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                }
            }
        }
    },
    "require": {
        "agrcmsx/dxbase": "^3.0.26",
        "agrcmsx/aafctheme": "*",
        "agrcmsx/agri_admin": "*",
        "agrcmsx/agri_reports": "*",
        "agrcmsx/prefer_latest_content": "*",
        "agrcmsx/wxt_overrides": "*",
        "agrcmsx/config": "3.0.x-dev",
        "drupal/core": "8.9.18 as 8.9.14",
        "drupal/linkit": "6.0-beta2 as 5.0-beta11",
        "drupal/wxt_bootstrap": "dev-4.x as 1.26",
        "drupal/wxt_library": "dev-4.x as 1.22",
        "drupal/file_replace": "^1.2",
        "drupal/reroute_email": "^1.3",
        "drupal/honeypot": "^2.0",
        "drupal/xhprof": "^1.0@beta",
        "perftools/php-profiler": "^0.18.0",
        "drupal/title_length": "^1.1",
        "drupal/bootstrap_site_alert": "^1.9",
        "drupal/view_custom_table": "^1.5",
        "drupal/varnishvanish": "^2.0@beta",
        "drupal/dynamic_entity_reference": "^1.12"
    },
    "authors": [
        {
            "name": "olstjos",
            "email": "j@7pro.ca"
        }
    ],
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
