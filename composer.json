{
    "name": "agrcmsx/internet",
    "description": "WxT based internet sub project",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_admin"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_reports"
        },
        {
            "type": "path",
            "url": "custom/modules/prefer_latest_content"
        },
        {
            "type": "path",
            "url": "custom/modules/wxt_overrides"
        },
        {
            "type": "path",
            "url": "custom/themes/aafctheme"
        },
        {
            "type": "path",
            "url": "custom/config"
        }
    ],
    "scripts": {
        "post-root-package-install": [
            "DrupalWxT\\WxT\\ScriptHandler::postCreateProject"
        ],
        "pre-install-cmd": [
            "if [ -d html/sites/default ]; then chmod 775 html/sites/default; fi"
        ],
        "post-install-cmd": [
            "bash post_install.sh"
        ],
        "post-update-cmd": [
            "bash post_install.sh"
        ],
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
          "bower-asset",
          "npm-asset",
          "custom-module",
          "custom-theme"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}" : [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/custom/{$name}": [
                "drupal/wxt_library",
                "type:drupal-custom-module"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/custom/{$name}": [
                "drupal/wxt_bootstrap",
                "type:drupal-custom-theme"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": false,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/embed_block": {
                "3225938 - Added CKEDITOR plugin functionality":
                "https://www.drupal.org/files/issues/2022-02-05/3225938_include_binary_icon-18.patch",
                "3225938 - Custom":
                "https://www.drupal.org/files/issues/2021-12-15/3225938-custom_only_diff-10.patch"
            },
            "drupal/filebrowser": {
                "Warning filesize:stat failed/filetype:Lstat failed/filectime:stat failed for a symlink":
                "https://www.drupal.org/files/issues/2021-10-22/filesize-statfailed-3245404-02.patch",
                "A custom feature needs to display the external URLs for uploaded files in the public folder":
                "https://www.drupal.org/files/issues/2022-01-18/Display-external-URLs-3254557-15.patch",
                "Access the private path and public path based on the user role":
                "https://www.drupal.org/files/issues/2021-12-30/Access-private-public-path-based-on-user-role-3256368-03.patch"
            },
            "drupal/core_contexts": {
                "3263703 - Layout builder and core contexts together": "https://www.drupal.org/files/issues/2022-03-10/3263703.patch"
            },
            "drupal/wxt": {
                "wcag - fix the report a problem webform markup":
                "https://www.drupal.org/files/issues/2021-01-22/wxt-ext-webform-config-change-3194287-3.patch"
            },
            "drupal/moderated_content_bulk_publish": {
                "3253887 - Change revision message on bulk Unpublish":
                "https://www.drupal.org/files/issues/2021-12-10/3253887-2.patch"
            }
        },
        "patches-ignore": {
            "drupalwxt/wxt": {
                "drupal/core": {
                    "Enter drupal/core patch #2559833 description here": "https://www.drupal.org/files/issues/2020-10-31/2559833-72.patch",
		    "Enter drupal/core patch #2630732 description here": "https://www.drupal.org/files/issues/2020-09-17/2630732-77.patch",
                    "Enter drupal/core patch #2907413 description here": "https://www.drupal.org/files/issues/2019-06-21/2907413-11.patch",
                    "Enter drupal/core patch #2922570 description here": "https://www.drupal.org/files/issues/2021-06-29/D91x-2922570-88.patch",
                    "2907413 - Rerolled patch for 9.3.x is in the patches section.": "https://www.drupal.org/files/issues/2019-06-21/2907413-11.patch",
                    "3150294 - Rerolled patch for 9.3.x is in the patches section.": "https://www.drupal.org/files/issues/2021-11-02/3150294-74.patch",
                    "2921627 - Rerolled patch for 9.3.x is in the patches section.": "https://www.drupal.org/files/issues/2021-09-07/2921627-68_3.patch",
                    "2922570 - Fixed in 9.3.0": "https://www.drupal.org/files/issues/2021-06-29/D91x-2922570-88.patch",
                    "2922570 - Fixed in 9.3.0 but not 9.2 roll": "https://www.drupal.org/files/issues/2021-09-08/2922570-90.9.2.5.patch",
                    "2922570 - See reroll in 2922570-88 (above).":
                    "https://www.drupal.org/files/issues/2021-02-02/2922570-61.patch",
                    "2893407 - POST /quickedit/metadata returning HTTP 503 - patch 39.":
                    "https://www.drupal.org/files/issues/2020-01-09/2893407-39.patch",
                    "1356276 - Overrides for profile and sub profile use 633 instead of 631-by-mpotter-balsa":
                    "https://www.drupal.org/files/issues/2020-12-13/1356276-633-by-mpotter-balsama-phenaproxima-9.1.0-9.2.x.patch",
                    "1356276 - Overrides for profile and sub profile use 686 instead of 656": "https://www.drupal.org/files/issues/2021-06-29/D91x-1356276-656.patch"
                },
                "drupal/moderation_sidebar": {
                    "Discard Draft for a translation edits the base language node, ignore this patch, use patch 7 instead": "https://www.drupal.org/files/issues/2021-02-12/3194841-3.patch"
                },
                "drupal/metatag": {
                    "2955407 - Obsolete patch ignore it": "https://www.drupal.org/files/issues/2020-12-18/Issue-2955407-Static-caching-for-token-processing-ic.patch"
                },
                "drupal/webform": {
                    "Enter drupal/webform patch #3212867 description here":
                    "https://www.drupal.org/files/issues/2021-05-07/3212867-3.patch"
                },
                "drupal/token": {
                    "2863200 - No longer need this patch, included in the latest release.":
                    "https://www.drupal.org/files/issues/2019-03-15/2863200-23.patch"
                }
            },
            "drupal/lightning_core": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order ignore 8.8.x patch":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order ignore 9.0.x patch":
                    "https://www.drupal.org/files/issues/2020-03-24/1356276-531-9.0.x-9.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch",
                    "overrides for profile and sub profile use 633 instead of 631":
                    "https://www.drupal.org/files/issues/2020-12-11/1356276-631-by-mpotter-balsama-phenaproxima.patch"
                }
            },
            "acquia/lightning": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                 }
            }
        }
    },
    "require": {
        "agrcmsx/dxbase": "9.3.3-rc20",
        "agrcmsx/aafctheme": "*",
        "agrcmsx/agri_admin": "*",
        "agrcmsx/agri_reports": "*",
        "agrcmsx/config": "*",
        "agrcmsx/prefer_latest_content": "*",
        "agrcmsx/wxt_overrides": "*",
        "drupal/bootstrap_site_alert": "^1.9",
        "drupal/core": "9.3.3 as 9.2.10",
        "drupal/embed_block": "1.x-dev",
        "drupal/filebrowser": "^3.0",
        "drupal/file_replace": "^1.2",
        "drupal/honeypot": "^2.0",
        "drupal/libraries": "^3.0",
        "drupal/xhprof": "^1.0@beta",
        "perftools/php-profiler": "^0.18.0",
        "drupal/purge": "3.0",
        "drupal/reroute_email": "^2.0",
        "drupal/title_length": "^1.1",
        "drupal/token_filter": "1.3 as 1.2",
        "drupal/varnish_purge": "^2.1",
        "drupal/view_custom_table": "^2.0",
        "drupal/media_library_edit": "^2.1",
        "drupal/webform_translation_permissions": "^1.1",
        "drupal/entity_embed": "^1.0",
        "drupal/video_embed_field": "^2.0",
        "drupal/views_infinite_scroll": "^1.6",
        "drupal/crop": "^2.2"
    },
    "authors": [
        {
            "name": "olstjos",
            "email": "j@7pro.ca"
        }
    ],
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
